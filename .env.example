# Réglages du serveur d'analyse. Copier en `.env` puis adapter.
# Aucune valeur secrète ici : uniquement des limites locales.

# Répertoire des sessions (fichiers audio conservés le temps de la lecture).
# Doit être un chemin absolu dont le dernier dossier se nomme
# « night-light-sessions », sinon la valeur par défaut est utilisée.
SESSION_DIR=/tmp/night-light-sessions

# Répertoire du cache persistant des morceaux déjà récupérés, gardés pour éviter
# de les re-télécharger. Contrairement aux sessions, il doit survivre au
# redémarrage : par défaut hors de /tmp, dans ~/.local/share/night-light/cache
# (ou $XDG_DATA_HOME/night-light/cache). Laisser vide utilise ce défaut.
CACHE_DIR=

# Taille d'envoi maximale, en Mo.
MAX_FILE_MB=40

# Durée de morceau maximale, en secondes.
MAX_DURATION_SEC=900

# Délai laissé à l'analyse d'un morceau, en secondes.
ANALYZE_TIMEOUT_SEC=240

# Durée de vie d'une session inactive, en secondes (30 minutes).
SESSION_TTL_SEC=1800

# Cookie « arl » d'une session web Deezer : requis pour la récupération
# automatique d'un morceau par titre/artiste (voir « Récupération d'un morceau »
# dans le README). C'est un secret : ne pas le versionner, ne pas le committer.
# Laisser vide désactive la récupération ; le serveur le dit alors clairement.
DEEZER_ARL=

# Ports utilisés par `bun run dev`.
API_PORT=8787
WEB_PORT=5173

# Le serveur n'a aucune authentification : il refuse de démarrer sur une
# adresse non locale (127.0.0.1, localhost, ::1). Mettre ALLOW_NETWORK=1 lève
# ce refus, à tes risques : n'expose jamais ce serveur à Internet.
ALLOW_NETWORK=
