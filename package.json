{
  "name": "night-light-v2",
  "version": "2.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Light show musical personnel : analyse audio serveur (librosa) + spectacle visuel synchronise dans le navigateur.",
  "engines": {
    "bun": ">=1.1",
    "node": ">=24"
  },
  "scripts": {
    "dev": "bun scripts/dev.mjs",
    "api": "uv run uvicorn server.main:app --host 127.0.0.1 --port 8787",
    "web": "portless nightlight vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "bun scripts/test.mjs",
    "check:browser": "bun tests/browser_check.mjs",
    "check:sync": "bun tests/sync_check.mjs",
    "check:dashboard": "bun tests/dashboard_check.mjs",
    "check:fallback": "bun tests/fallback_check.mjs",
    "check:family": "bun tests/family_check.mjs"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "latest",
    "playwright": "^1.50.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "peerDependencies": {
    "typescript": "^7.0.2"
  }
}
